{# Import Macro file with site specific variables #}
{% import '$site.j2' as site %}
{# Set the switch type based on the hostname of the switch in the old config #}
{% set switch_type = "$switch_type" %}
{% if switch_type == 'router' %}
!Configured routing
ip routing
ip multicast-routing
{% endif %}
!
no wsma agent exec
no wsma agent config
no wsma agent filesys
no wsma agent notify
no wsma profile listener httplistener
no wsma profile listener httpslistener
no service pad
no service call-home
service timestamps debug datetime msec localtime show-timezone
service timestamps log datetime msec localtime show-timezone
service password-encryption
service compress-config
service unsupported-transceiver
no ip finger
no call-home
no ip http server
no ip http authentication local
no ip http secure-server
no service tcp-small-servers
no service udp-small-servers
no tftp-server *
no service config
no ip source-route
no ip domain lookup
service tcp-keepalives-in
service tcp-keepalives-out
no logging console
no logging monitor
logging buffered 40960
ip subnet-zero
port-channel load-balance src-dst-mixed-ip-port
qos queue-softmax-multiplier 4800
!
exception crashinfo maximum files 3
!
epm logging
!
device-sensor accounting
device-sensor notify all-changes
!
vtp mode off
!
archive
 log config
  logging enable
  logging size 1000
  hidekeys
  notify syslog
!
no platform punt-keepalive disable-kernel-core
!
hostname {{ hostname }}
!
!
!
aaa new-model
aaa authentication login default group tacacs+ local enable
aaa authentication login consoleport group tacacs+ local enable
aaa authentication login no_tacacs line
aaa authorization config-commands
aaa authorization exec default group tacacs+ if-authenticated
aaa authorization exec consoleport group tacacs+ local if-authenticated
aaa authorization commands 1 default local group tacacs+ none
aaa authorization commands 15 default local group tacacs+ none
aaa authorization commands 15 consoleport group tacacs+ local if-authenticated
aaa accounting exec default start-stop group tacacs+
aaa accounting exec consoleport start-stop group tacacs+
aaa accounting commands 0 default start-stop group tacacs+
aaa accounting commands 15 default stop-only group tacacs+
aaa accounting commands 15 consoleport start-stop group tacacs+
aaa accounting connection default start-stop group tacacs+
aaa accounting system default start-stop group tacacs+
aaa accounting update newinfo periodic 2880
{% if switch_type == 'access' %}
aaa authentication dot1x default group radius
aaa authorization network default group radius
aaa accounting dot1x default start-stop group radius
aaa accounting identity default start-stop group radius
{% endif %}
!
!
!
!
!
!
aaa session-id common
clock timezone utc 0
!
!
!
