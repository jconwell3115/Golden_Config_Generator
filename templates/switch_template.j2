ip domain name ndc.nasa.gov
!
!
{% if switch_type == 'access' %}
ip dhcp snooping vlan 1 4094
no ip dhcp snooping information option
no ip dhcp snooping verify mac-address
ip dhcp snooping
{% endif %}
!
login on-success log
!
!
!
!
!
device-sensor accounting
device-sensor notify all-changes
!
!
!
vtp mode off
udld enable

epm logging
authentication mac-move permit
no device-tracking logging theft
device-tracking tracking
!
!
!
!
!
dot1x system-auth-control
{# Add system mtu if it's configured in the old config #}
{% if mtu|length > 0 %}
!!!! Configured system MTU from old configuration !!!!
system mtu {{ mtu }}
!
{% endif %}
!
license boot level network-advantage addon dna-advantage
license smart reservation
!
!
diagnostic bootup level minimal
!
spanning-tree mode rapid-pvst
spanning-tree portfast bpduguard default
spanning-tree extend system-id
!
errdisable recovery cause udld
errdisable recovery cause link-flap
errdisable recovery interval 900

{# Configure local user and enable password per site specific variable #}
{{ site.user() }}
!
redundancy
 mode sso
!
!
!
{% if switch_type == 'router' %}
!!!! Configured Netflow for routers !!!!
flow record SNA-FLOW_RECORD
  description LAN IP NetFlow record format to send to SNA
  match ipv4 tos
  match ipv4 protocol
  match ipv4 source address
  match ipv4 destination address
  match transport source-port
  match transport destination-port
  match interface input
  collect transport tcp flags
  collect interface output
  collect counter bytes long
  collect counter packets long
  collect timestamp absolute first
  collect timestamp absolute last
!
flow exporter NETFLOW_TO_SNA_FC
  description Export LAN NetFlow to SNA FC
  destination {{ site.flow_collector() }}
  source {{ source_interface }}
  transport udp 2055
  template data timeout 10
!
flow monitor LAN_NETFLOW
  record SNA-FLOW_RECORD
  exporter NETFLOW_TO_SNA_FC
  cache timeout active 60
  cache timeout inactive 15
{% endif %}
!
!
!
transceiver type all
 monitoring
{# Configure VLANs from the self.vlan_dict #}
!Configured VLANs from old configuration
{% for vlan in vlans %}
vlan {{ vlan }}
name {{ vlans[vlan].name }}
!
{% endfor %}
!!!vlan_priority
!
!
!
{# Configure interfaces from old config #}
!!!Interfaces
!
{# Configure routing protocol instances if there are any #}
!!!router_config
!
{# Configure Default Gateway if there is one #}
{% if gateway|length > 0 %}
!Configured default-gateway from old configuration
ip default-gateway {{ gateway }}
!
{% endif %}
ip forward-protocol nd
no ip forward-protocol udp tftp
no ip forward-protocol udp domain
no ip forward-protocol udp time
no ip forward-protocol udp netbios-ns
no ip forward-protocol udp netbios-dgm
no ip forward-protocol udp tacacs
{# Configure rp-address from old config #}
!!!rp-address
no ip pim autorp
ip pim register-source {{ source_interface }}
ip pim ssm default
no ip http server
no ip http secure-server
ip http client source-interface {{ source_interface }}
{# Configure static routes #}
!!!ip_route
ip tacacs source-interface {{ source_interface }}
ip radius source-interface {{ source_interface }}
ip ssh time-out 60
ip ssh authentication-retries 2
ip ssh source-interface {{ source_interface }}
ip ssh version 2
ip ssh server algorithm mac hmac-sha2-256
ip ssh server algorithm encryption aes256-ctr
ip ssh server algorithm kex diffie-hellman-group14-sha1
no ip ssh server algorithm mac hmac-sha1
ip scp server enable
crypto key generate rsa general-keys modulus 2048
ntp source {{ source_interface }}
!
!
!
!
!
logging source-interface {{ source_interface }}
{# Configure logging parameters from old config #}
!!!logging
{# Configure multicast ACLs for routers. #}
{% if switch_type == 'router' %}
{{ site.multicast() }}
{% endif %}
